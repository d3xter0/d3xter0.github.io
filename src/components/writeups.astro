---

interface Writeup {
  title: string;
  platform: string;
  type: string;
  difficulty: string;
  date: string;
  link: string;
}

const writeups: Writeup[] = [
  {
    title: "CCTV",
    platform: "Hack The Box",
    type: "Machine",
    difficulty: "Easy",
    date: "Oct 2026",
    link: "/writeups/cctv/",
  },
  {
    title: "Writeup Two",
    platform: "Hack The Box",
    type: "Machine",
    difficulty: "Medium",
    date: "Oct 2026",
    link: "https://example.com",
  },
  {
    title: "Writeup Three",
    platform: "TryHackMe",
    type: "Room",
    difficulty: "Easy",
    date: "Sep 2026",
    link: "https://example.com",
  },
  {
    title: "Writeup Four",
    platform: "TryHackMe",
    type: "Room",
    difficulty: "Hard",
    date: "Sep 2026",
    link: "https://example.com",
  },
];

const difficultyColor: Record<string, string> = {
  Easy: "text-[#A9FF5B]",
  Medium: "text-[#FFC857]",
  Hard: "text-[#FF6B6B]",
};
---

<section
  id="writeups"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">CTF & Labs</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Writeups</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        writeups.map((writeup) => (
          <a
            href={writeup.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col justify-between rounded-2xl p-6 border border-1 border-[var(--white-icon-tr)] bg-[#1414149c] hover:bg-[var(--white-icon-tr)] transition duration-300 ease-in-out"
          >
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span class="text-sm text-[var(--white-icon)]">
                  {writeup.platform}
                </span>
                <span class="text-sm text-[var(--white-icon)]">•</span>
                <span class="text-sm text-[var(--white-icon)]">
                  {writeup.type}
                </span>
                <span class="text-sm text-[var(--white-icon)]">•</span>
                <span
                  class={`text-sm font-medium ${difficultyColor[writeup.difficulty] ?? ""}`}
                >
                  {writeup.difficulty}
                </span>
              </div>
              <h4 class="text-2xl font-semibold group-hover:text-white transition-colors">
                {writeup.title}
              </h4>
            </div>
            <div class="flex items-center justify-between mt-6">
              <span class="text-sm text-[var(--white-icon)]">
                {writeup.date}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-6 text-[var(--white-icon)] group-hover:text-white group-hover:translate-x-1 transition-all duration-300"
              >
                <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
              </svg>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
